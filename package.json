{
  "name": "@qwipo/aiagent",
  "version": "1.0.0",
  "description": "Azure DevOps CI/CD automation agent - CLI tool",
  "main": "electron/main.js",
  "bin": {
    "qwipo": "./index.js"
  },
  "scripts": {
    "start": "node index.js",
    "setup": "node index.js --setup",
    "web": "node src/web/server.js",
    "app": "electron electron/main.js",
    "dist": "electron-builder --mac"
  },
  "keywords": [
    "azure-devops",
    "cli",
    "agent",
    "ci-cd"
  ],
  "license": "PRIVATE",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.86.1",
    "chalk": "^4.1.2",
    "configstore": "^5.0.1",
    "inquirer": "^8.2.6",
    "ora": "^5.4.1"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.qwipo.devops",
    "productName": "Qwipo DevOps",
    "files": [
      "electron/**/*",
      "index.js",
      "src/**/*",
      "!src/web/credentials.json",
      "package.json"
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.developer-tools"
    }
  }
}
