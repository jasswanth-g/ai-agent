{
  "name": "@qwipo/aiagent",
  "version": "1.0.0",
  "description": "Azure DevOps Build & Release web app for Qwipo",
  "author": "Qwipo",
  "main": "electron/main.js",
  "scripts": {
    "web": "node src/web/server.js",
    "app": "electron electron/main.js",
    "dist": "electron-builder --mac"
  },
  "keywords": [
    "azure-devops",
    "ci-cd"
  ],
  "license": "PRIVATE",
  "dependencies": {
    "configstore": "^5.0.1"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.qwipo.devops",
    "productName": "Qwipo DevOps",
    "files": [
      "electron/**/*",
      "src/**/*",
      "!src/web/credentials.json",
      "package.json"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": "universal"
        }
      ],
      "category": "public.app-category.developer-tools"
    },
    "publish": {
      "provider": "github",
      "owner": "jasswanth-g",
      "repo": "ai-agent"
    }
  }
}
