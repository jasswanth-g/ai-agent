{
  "name": "deploymate",
  "version": "1.0.0",
  "description": "DeployMate — Azure DevOps Build & Release desktop app",
  "author": "DeployMate",
  "main": "electron/main.js",
  "scripts": {
    "web": "node src/web/server.js",
    "app": "electron electron/main.js",
    "dist": "electron-builder --mac",
    "dist:unsigned": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac",
    "dist:release": "electron-builder --mac -c.mac.notarize.teamId=$APPLE_TEAM_ID"
  },
  "keywords": [
    "azure-devops",
    "ci-cd"
  ],
  "license": "PRIVATE",
  "dependencies": {
    "configstore": "^5.0.1"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.deploymate.app",
    "productName": "DeployMate",
    "afterPack": "build/adhoc-sign.js",
    "files": [
      "electron/**/*",
      "src/**/*",
      "!src/web/credentials.json",
      "package.json"
    ],
    "mac": {
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "target": [
        {
          "target": "dmg",
          "arch": "universal"
        }
      ],
      "category": "public.app-category.developer-tools"
    },
    "publish": {
      "provider": "github",
      "owner": "jasswanth-g",
      "repo": "ai-agent"
    }
  }
}
